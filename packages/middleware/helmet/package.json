{
	"name": "@pulsar/helmet",
	"type": "module",
	"version": "0.0.1",
	"description": "Simple middleware to add Express' helmet middleware integration for Pulsar.",
	"author": "Ernest Nkansah-Badu <ernestjbadu@outlook.com>",
	"license": "MIT",
	"homepage": "https://pulsarjs.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ernxst/pulsar.git",
		"directory": "packages/middleware/helmet"
	},
	"bugs": {
		"url": "https://github.com/Ernxst/pulsar/issues"
	},
	"keywords": [
		"pulsar",
		"helmet",
		"security",
		"app",
		"application",
		"headers"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"require": "./dist/index.js"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts",
				"./dist/index.d.cts"
			]
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=v16.0.0"
	},
	"scripts": {
		"build": "tsup src --dts",
		"postbuild": "publint"
	},
	"peerDependencies": {
		"pulsar": "^0.0.1"
	},
	"peerDependenciesMeta": {
		"pulsar": {
			"optional": false
		}
	},
	"devDependencies": {
		"helmet": "7.0.0",
		"pulsar": "^0.0.1"
	}
}
