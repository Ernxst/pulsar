{
	"name": "@pulsar/sentry",
	"type": "module",
	"version": "0.0.1",
	"description": "Simple middleware adding Sentry integration to Pulsar.",
	"author": "Ernest Nkansah-Badu <ernestjbadu@outlook.com>",
	"license": "MIT",
	"homepage": "https://pulsarjs.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ernxst/pulsar.git",
		"directory": "packages/middleware/sentry"
	},
	"bugs": {
		"url": "https://github.com/Ernxst/pulsar/issues"
	},
	"keywords": [
		"pulsar",
		"sentry",
		"logging",
		"exception",
		"error",
		"toucan-js"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=v16.0.0"
	},
	"scripts": {
		"build": "tsup src --dts",
		"postbuild": "publint"
	},
	"peerDependencies": {
		"pulsar": "^0.0.1",
		"toucan-js": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"pulsar": {
			"optional": false
		},
		"toucan-js": {
			"optional": false
		}
	}
}
