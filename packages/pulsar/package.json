{
	"name": "pulsar",
	"type": "module",
	"version": "0.0.1",
	"description": "A dead-simple, type-safe API framework built on Web standards for the edge.",
	"author": "Ernest Nkansah-Badu <ernestjbadu@outlook.com>",
	"license": "MIT",
	"homepage": "https://pulsarjs.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ernxst/pulsar.git",
		"directory": "packages/pulsar"
	},
	"bugs": {
		"url": "https://github.com/Ernxst/pulsar/issues"
	},
	"keywords": [
		"pulsar",
		"edge",
		"web",
		"app",
		"http",
		"application",
		"framework",
		"router",
		"cloudflare",
		"workers",
		"fastly",
		"compute@edge",
		"deno",
		"bun",
		"lagon",
		"lambda",
		"nodejs"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"require": "./dist/index.js"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		},
		"./internals": {
			"require": {
				"types": "./dist/internals/index.d.cts",
				"require": "./dist/internals/index.cjs"
			},
			"import": {
				"types": "./dist/internals/index.d.ts",
				"import": "./dist/internals/index.js"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts",
				"./dist/index.d.cts"
			],
			"internals": [
				"./dist/internals/index.d.ts",
				"./dist/internals/index.d.cts"
			]
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=v16.0.0"
	},
	"scripts": {
		"------------------------------------------------------------------------------": "",
		"build": "tsup --dts --clean",
		"postbuild": "publint",
		"-------------------------------------------------------------------------------": "",
		"typecheck": "tsc --noEmit",
		"--------------------------------------------------------------------------------": "",
		"test": "vitest run",
		"test:types": "vitest typecheck"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "^4.20230724.0",
		"zod": "^3.20.2"
	},
	"peerDependenciesMeta": {
		"@cloudflare/workers-types": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"hono": "3.3.4",
		"pretty-cache-header": "1.0.0",
		"type-fest": "4.0.0"
	}
}
