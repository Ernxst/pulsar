{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "tsup.config.ts",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "test:types": {
      "outputs": []
    }
  }
}
